# Listing of Parameters
# ---------------------

set dimension = 3

# --------------------------------------------------
# Simulation Control
#---------------------------------------------------
subsection simulation control
  set method                  = steady
  set number mesh adapt       = 3
  set output name             = unstructured_pb_output
  set output frequency        = 1
  set subdivision             = 1
 # set output boundaries        = true
end

#---------------------------------------------------
# FEM
#---------------------------------------------------
subsection FEM
    set velocity order        = 1
    set pressure order        = 1
end

#---------------------------------------------------
# Timer
#---------------------------------------------------
subsection timer
    set type    = iteration                                  # <none|iteration|end>
end

#---------------------------------------------------
# Initial condition
#---------------------------------------------------
subsection initial conditions
    set type = nodal
    subsection uvwp
            set Function expression = 0; 0; 0; 0
    end
end

#---------------------------------------------------
# Physical Properties
#---------------------------------------------------
subsection physical properties
    subsection fluid 0
        set kinematic viscosity            = 0.00100
    end
end

#---------------------------------------------------
# Mesh
#---------------------------------------------------
subsection mesh
    set type                 = gmsh
    set file name            = packed_bed.msh
end

# --------------------------------------------------
# Boundary Conditions
#---------------------------------------------------
subsection boundary conditions
  set number                  = 4
    subsection bc 0
        set id                = 10
        set type              = function
        subsection u
            set Function expression = 0
        end
        subsection v
            set Function expression = 0
        end
        subsection w
            set Function expression = 1
        end
    end
    subsection bc 1
        set id                = 11
        set type              = outlet
    end
    subsection bc 2
        set id                = 12
        set type              = slip
    end
    subsection bc 3
        set id                = 13
        set type              = noslip
    end
end

subsection mesh adaptation
  # Type of mesh adaptation. Choices are  none, uniform or kelly.
  set type                     = kelly

  # Variable(s) for kelly estimation. Choices are velocity, pressure, phase or temperature.
  # For multi-variables refinement, separate the different variables with a comma
  set variable                 = pressure

  # Fraction of coarsened elements
  # For multi-variables refinement, separate the different fractions with a comma
  set fraction coarsening      = 0.00

  # Fraction of refined elements
  # For multi-variables refinement, separate the different fractions with a comma
  set fraction refinement      = 0.025

  set fraction type            = fraction

end

# --------------------------------------------------
# Non-Linear Solver Control
#---------------------------------------------------
subsection non-linear solver
    subsection fluid dynamics
        set verbosity               = verbose
        set tolerance               = 1e-10
        set max iterations          = 10
    end
end

# --------------------------------------------------
# Linear Solver Control
#---------------------------------------------------
subsection linear solver
    subsection fluid dynamics
        set verbosity               = verbose
        set method                  = gmres
        set preconditioner          = amg
        set max iters               = 7000
        set relative residual       = 1e-2
        set minimum residual        = 1e-11
        set ilu preconditioner fill = 0
        set ilu preconditioner absolute tolerance = 1e-12
        set ilu preconditioner relative tolerance = 1.00
    end 
end
